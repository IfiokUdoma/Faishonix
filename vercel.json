{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/faishonix",
      "destination": "/index.html"
    },
    {
      "source": "/api/style",
      "destination": "/api/router?route=style"
    },
    {
      "source": "/api/auth",
      "destination": "/api/router?route=auth"
    },
    {
      "source": "/api/wardrobe",
      "destination": "/api/router?route=wardrobe"
    },
    {
      "source": "/api/session",
      "destination": "/api/router?route=session"
    },
    {
      "source": "/api/scans",
      "destination": "/api/router?route=scans"
    },
    {
      "source": "/api/vendor",
      "destination": "/api/router?route=vendor"
    },
    {
      "source": "/api/try-on",
      "destination": "/api/router?route=try-on"
    },
    {
      "source": "/api/try-on/:id",
      "destination": "/api/router?route=try-on/:id"
    },
    {
      "source": "/api/vendor-registration",
      "destination": "/api/router?route=vendor-registration"
    },
    {
      "source": "/api/fit-requests",
      "destination": "/api/router?route=fit-requests"
    },
    {
      "source": "/shop",
      "destination": "/index.html"
    },
    {
      "source": "/body-scan",
      "destination": "/index.html"
    },
    {
      "source": "/foot-scan",
      "destination": "/index.html"
    },
    {
      "source": "/wardrobe",
      "destination": "/index.html"
    },
    {
      "source": "/orders",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/vendor",
      "destination": "/index.html"
    },
    {
      "source": "/try-on",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/store-sdk.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
