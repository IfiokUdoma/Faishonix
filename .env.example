# Environment template for the planned Vercel + Supabase backend.
# Copy to .env.local at the repository root for local development.
# Add real values only in .env.local and Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Leave blank until virtual try-on is enabled.
REPLICATE_API_TOKEN=
TRY_ON_MODEL_VERSION=
TRY_ON_DAILY_LIMIT=20
